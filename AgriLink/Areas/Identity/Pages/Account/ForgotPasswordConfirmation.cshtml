@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check Your Email";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5">
                <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle mx-auto mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-envelope-check-fill fs-1"></i>
                </div>
                <h2 class="fw-bold text-success mb-2">Check Your Email</h2>
                <p class="text-muted mb-4">
                    If an account with that email address exists, we've sent a password reset link. Please check your inbox (and spam/junk folder).
                </p>

                <div class="alert alert-light border small text-start mb-4">
                    <div class="fw-semibold mb-1"><i class="bi bi-info-circle me-1 text-primary"></i>Didn't receive an email?</div>
                    <ul class="mb-0 ps-3 text-muted">
                        <li>Check your spam or junk folder.</li>
                        <li>Make sure you entered the email you used to register.</li>
                        <li>It may take 1–2 minutes to arrive.</li>
                    </ul>
                </div>

                <a asp-page="./Login" class="btn btn-outline-success">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Return to Login
                </a>
            </div>
        </div>
    </div>
</div>
