@model AgriLink.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card border-0 shadow-sm border-danger border-top border-4">
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    <div class="fs-1 text-danger">⚠️</div>
                    <h4 class="fw-bold text-danger">Delete Category</h4>
                    <p class="text-muted">Are you sure you want to delete this category? This action cannot be undone.</p>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted fw-semibold">Category Name</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Name</dd>

                        <dt class="col-sm-4 text-muted fw-semibold">Description</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Description) ? "None" : Model.Description)</dd>
                    </dl>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-2">
                    <input type="hidden" asp-for="CategoryId" />
                    <button type="submit" class="btn btn-danger fw-bold px-4">Delete Category</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
