@model IEnumerable<AgriLink.Models.Category>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Manage Categories</h2>
        <p class="text-muted mb-0">Create and manage produce categories for the platform</p>
    </div>
    <a asp-action="Create" class="btn btn-success fw-bold">+ New Category</a>
</div>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Category Name</th>
                    <th>Description</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-dark">
                            <span class="fs-5 me-2">
                                @switch (item.Name.ToLower())
                                {
                                    case var n when n.Contains("veg"):
                                        @:🥦
                                        break;
                                    case var n when n.Contains("fruit"):
                                        @:🍎
                                        break;
                                    case var n when n.Contains("grain") || n.Contains("pulse"):
                                        @:🌾
                                        break;
                                    case var n when n.Contains("spice"):
                                        @:🌶️
                                        break;
                                    default:
                                        @:🌱
                                        break;
                                }
                            </span>
                            @item.Name
                        </td>
                        <td class="text-muted">@item.Description</td>
                        <td class="text-end pe-4 text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
