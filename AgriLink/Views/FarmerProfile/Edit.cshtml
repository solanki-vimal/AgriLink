@model AgriLink.ViewModels.FarmerProfileFormViewModel

@{
    ViewData["Title"] = "Edit Farm Profile";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UserId" />

            <div class="mb-3">
                <label asp-for="FarmName" class="form-label"></label>
                <input asp-for="FarmName" class="form-control" />
                <span asp-validation-for="FarmName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FarmLocation" class="form-label"></label>
                <input asp-for="FarmLocation" class="form-control" />
                <span asp-validation-for="FarmLocation" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="FarmSizeAcres" class="form-label"></label>
                    <input asp-for="FarmSizeAcres" class="form-control" />
                    <span asp-validation-for="FarmSizeAcres" class="text-danger"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="YearsOfExperience" class="form-label"></label>
                    <input asp-for="YearsOfExperience" class="form-control" />
                    <span asp-validation-for="YearsOfExperience" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Bio" class="form-label"></label>
                <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Tell buyers a bit about your farm..."></textarea>
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ExistingFarmImageUrl))
            {
                <div class="mb-2">
                    <img src="@Model.ExistingFarmImageUrl" alt="Current farm image" style="width:120px;height:120px;object-fit:cover;" class="rounded" />
                    <div class="form-text">Current image — upload a new one below to replace it.</div>
                </div>
            }

            <div class="mb-3">
                <label asp-for="FarmImageFile" class="form-label"></label>
                <input asp-for="FarmImageFile" type="file" class="form-control" accept="image/*" />
                <span asp-validation-for="FarmImageFile" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save Profile</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
