@model AgriLink.ViewModels.ProduceDetailsViewModel

@{
    ViewData["Title"] = $"{Model.Produce.Name} - Details & Price Trends";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Browse" asp-action="Index">Marketplace</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Produce.Name</li>
    </ol>
</nav>

<div class="row g-4">
    <!-- Produce Info & Image Column -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm overflow-hidden mb-4">
            @if (!string.IsNullOrEmpty(Model.Produce.ImageUrl))
            {
                <img src="@Model.Produce.ImageUrl" class="card-img-top" alt="@Model.Produce.Name" style="max-height: 380px; object-fit: cover;">
            }
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-2 fs-6">@Model.Produce.Category?.Name</span>
                    <span class="fs-2 fw-bold text-success">₹@Model.Produce.Price <small class="fs-6 text-muted fw-normal">/ @Model.Produce.Unit</small></span>
                </div>

                <h1 class="fw-bold mb-2">@Model.Produce.Name</h1>
                <p class="text-muted mb-3">📍 @Model.Produce.Location</p>

                <hr />

                <div class="row text-center my-3 bg-light py-3 rounded-3 g-2">
                    <div class="col-4 border-end">
                        <small class="text-muted text-uppercase d-block fw-semibold" style="font-size:0.75rem;">Available Stock</small>
                        <strong class="fs-5 text-dark">@Model.Produce.Quantity @Model.Produce.Unit</strong>
                    </div>
                    <div class="col-4 border-end">
                        <small class="text-muted text-uppercase d-block fw-semibold" style="font-size:0.75rem;">Harvest Date</small>
                        <strong class="fs-5 text-dark">@Model.Produce.HarvestDate.ToString("MMM dd, yyyy")</strong>
                    </div>
                    <div class="col-4">
                        <small class="text-muted text-uppercase d-block fw-semibold" style="font-size:0.75rem;">Status</small>
                        @if (Model.Produce.Status == AgriLink.Models.ProduceStatus.Available)
                        {
                            <span class="badge bg-success">In Stock</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Sold Out</span>
                        }
                    </div>
                </div>

                <h5 class="fw-bold mt-4 mb-2">Product Description</h5>
                <p class="text-secondary" style="line-height:1.7;">
                    @(string.IsNullOrEmpty(Model.Produce.Description) ? "No additional description provided by the farmer." : Model.Produce.Description)
                </p>

                <!-- Order Action Card -->
                <div class="card bg-success bg-opacity-10 border-0 p-3 mt-4 rounded-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h6 class="fw-bold mb-1 text-success">Interested in purchasing this harvest?</h6>
                            <small class="text-muted">Direct order placement with instant quantity validation.</small>
                        </div>
                        <div>
                            @if (User.IsInRole("Buyer") || User.Identity == null || !User.Identity.IsAuthenticated)
                            {
                                <a asp-controller="Order" asp-action="Create" asp-route-produceId="@Model.Produce.ProduceId" class="btn btn-success fw-bold px-4 py-2">
                                    🛒 Place Order
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2">Logged in as @User.Identity.Name</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 5: Chart.js Price History & Trend Visualization -->
        <div class="card border-0 shadow-sm p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0">📈 Price Trend &amp; Market Benchmark</h5>
                    <small class="text-muted">Historical price changes for this listing</small>
                </div>
                @if (Model.MarketPriceBenchmark != null)
                {
                    <span class="badge bg-info text-dark fw-semibold">
                        Daily Benchmark: ₹@Model.MarketPriceBenchmark.PricePerUnit / @Model.MarketPriceBenchmark.Unit
                    </span>
                }
            </div>

            <div style="position: relative; height:260px; width:100%;">
                <canvas id="priceHistoryChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Farmer Profile Side Column (Section 1) -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
            <div class="card-header bg-light fw-bold py-3">
                👩‍🌾 Meet the Farmer
            </div>
            <div class="card-body p-4 text-center">
                @if (Model.FarmerProfile != null && !string.IsNullOrEmpty(Model.FarmerProfile.FarmImageUrl))
                {
                    <img src="@Model.FarmerProfile.FarmImageUrl" alt="@Model.FarmerProfile.FarmName" class="rounded-circle mb-3 shadow-sm" style="width:120px; height:120px; object-fit:cover;" />
                }
                else
                {
                    <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width:100px; height:100px; font-size: 2.5rem;">
                        🌾
                    </div>
                }

                <h4 class="fw-bold mb-1">
                    @(Model.FarmerProfile != null ? Model.FarmerProfile.FarmName : "Local Farm Producer")
                </h4>
                <p class="text-muted small mb-3">
                    Listed by <strong>@Model.Produce.Farmer?.FullName</strong>
                </p>

                <div class="row text-start bg-light p-3 rounded-3 g-2 mb-3">
                    <div class="col-6">
                        <small class="text-muted d-block fw-semibold" style="font-size:0.75rem;">FARM LOCATION</small>
                        <span class="fw-semibold">@(Model.FarmerProfile?.FarmLocation ?? Model.Produce.Location)</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block fw-semibold" style="font-size:0.75rem;">FARM SIZE</small>
                        <span class="fw-semibold">@(Model.FarmerProfile?.FarmSizeAcres != null ? $"{Model.FarmerProfile.FarmSizeAcres} Acres" : "N/A")</span>
                    </div>
                    <div class="col-6 mt-2">
                        <small class="text-muted d-block fw-semibold" style="font-size:0.75rem;">EXPERIENCE</small>
                        <span class="fw-semibold">@(Model.FarmerProfile?.YearsOfExperience != null ? $"{Model.FarmerProfile.YearsOfExperience} Years" : "N/A")</span>
                    </div>
                    <div class="col-6 mt-2">
                        <small class="text-muted d-block fw-semibold" style="font-size:0.75rem;">JOINED</small>
                        <span class="fw-semibold">@Model.Produce.Farmer?.CreatedAt.ToString("MMM yyyy")</span>
                    </div>
                </div>

                @if (Model.FarmerProfile != null && !string.IsNullOrEmpty(Model.FarmerProfile.Bio))
                {
                    <div class="text-start">
                        <h6 class="fw-bold mb-1">About the Farm</h6>
                        <p class="text-secondary small mb-0">@Model.FarmerProfile.Bio</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('priceHistoryChart').getContext('2d');
            
            const labels = @Json.Serialize(Model.ChartLabels);
            const dataPrices = @Json.Serialize(Model.ChartPrices);

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Listing Price (₹/@Model.Produce.Unit)',
                        data: dataPrices,
                        borderColor: '#198754',
                        backgroundColor: 'rgba(25, 135, 84, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 6,
                        pointBackgroundColor: '#198754'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: false,
                            title: {
                                display: true,
                                text: 'Price (₹)'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Date'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        }
                    }
                }
            });
        });
    </script>
}
