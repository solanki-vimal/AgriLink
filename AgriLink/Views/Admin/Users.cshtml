@model IEnumerable<AgriLink.Models.ApplicationUser>
@{
    ViewData["Title"] = "All Users";
    var roleNames = (Dictionary<string, string>)ViewBag.RoleNames;
    var lockedOutStatus = (Dictionary<string, bool>)ViewBag.LockedOutStatus;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<h1>@ViewData["Title"]</h1>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Address</th>
            <th>Role</th>
            <th>Status</th>
            <th>Joined</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            var isLockedOut = lockedOutStatus[user.Id];
            var isSelf = user.Id == currentUserId;

            <tr>
                <td>@user.FullName @if (isSelf) { <span class="text-muted small">(you)</span> }</td>
                <td>@user.Email</td>
                <td>@user.Address</td>
                <td><span class="badge bg-secondary">@roleNames[user.Id]</span></td>
                <td>
                    @if (isLockedOut)
                    {
                        <span class="badge bg-danger">Deactivated</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Active</span>
                    }
                </td>
                <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                <td class="text-nowrap">
                    @if (!isSelf)
                    {
                        <form asp-action="ToggleLockout" asp-route-id="@user.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm @(isLockedOut ? "btn-outline-success" : "btn-outline-warning")">
                                @(isLockedOut ? "Activate" : "Deactivate")
                            </button>
                        </form>
                        <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
