@model AgriLink.Models.ApplicationUser

@{
    ViewData["Title"] = "Delete User";
}

<h1>@ViewData["Title"]</h1>

<h3>Are you sure you want to delete this user?</h3>
<div class="alert alert-warning">
    This only works if the user has no existing listings, orders, or market price entries.
    Otherwise, deactivate the account instead.
</div>

<dl class="row">
    <dt class="col-sm-2">Full Name</dt>
    <dd class="col-sm-10">@Model.FullName</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2">Role</dt>
    <dd class="col-sm-10">@ViewBag.Role</dd>
</dl>

<form asp-action="DeleteUser" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Delete User</button>
    <a asp-action="Users" class="btn btn-secondary">Cancel</a>
</form>
