@model IEnumerable<AgriLink.Models.Order>
@using AgriLink.Models
@{
    ViewData["Title"] = "All Orders";
}

<h1 class="h2 mb-3">@ViewData["Title"]</h1>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-4 text-center my-4">
        <p class="text-muted mb-0">No orders have been placed on the platform yet.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order #</th>
                        <th>Produce</th>
                        <th>Farmer</th>
                        <th>Buyer</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                        <th>Order Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        var produceName = !string.IsNullOrWhiteSpace(order.ProduceName) ? order.ProduceName : (order.Produce?.Name ?? "Produce Item");
                        var unit = !string.IsNullOrWhiteSpace(order.Unit) ? order.Unit : (order.Produce?.Unit ?? "units");
                        var farmerName = !string.IsNullOrWhiteSpace(order.FarmerName) ? order.FarmerName : (order.Produce?.Farmer?.FullName ?? "—");
                        var buyerName = order.Buyer?.FullName ?? "—";
                        var unitPrice = order.UnitPrice > 0 ? order.UnitPrice : (order.QuantityOrdered > 0 ? Math.Round(order.TotalPrice / order.QuantityOrdered, 2) : 0);

                        <tr>
                            <td class="fw-bold">#@order.OrderId</td>
                            <td>@produceName</td>
                            <td>@farmerName</td>
                            <td>@buyerName</td>
                            <td>@order.QuantityOrdered @unit</td>
                            <td>₹@unitPrice.ToString("N2")</td>
                            <td class="fw-bold text-success">₹@order.TotalPrice.ToString("N2")</td>
                            <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                @{
                                    var badgeClass = order.Status switch
                                    {
                                        OrderStatus.Pending => "bg-warning text-dark",
                                        OrderStatus.Negotiating => "bg-info text-dark",
                                        OrderStatus.Accepted => "bg-primary",
                                        OrderStatus.Completed => "bg-success",
                                        OrderStatus.Rejected => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@order.Status</span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-controller="Order" asp-action="Confirmation" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-secondary" title="View Order Confirmation & Details">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                @if (order.Status == OrderStatus.Negotiating)
                                {
                                    <a asp-controller="Order" asp-action="Negotiate" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary ms-1" title="View Negotiation Thread">
                                        <i class="bi bi-chat-quote"></i> Negotiate
                                    </a>
                                }
                                @if (order.Status != OrderStatus.Rejected)
                                {
                                    <a asp-controller="Order" asp-action="Receipt" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-success ms-1" title="View Sales Receipt / Summary">
                                        <i class="bi bi-receipt"></i> Receipt
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
