@model IEnumerable<AgriLink.Models.Order>
@using AgriLink.Models
@{
    ViewData["Title"] = "All Orders";
}

<h1>@ViewData["Title"]</h1>

@if (!Model.Any())
{
    <p class="text-muted">No orders have been placed on the platform yet.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Produce</th>
                <th>Buyer</th>
                <th>Quantity</th>
                <th>Total Price</th>
                <th>Order Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Produce?.Name</td>
                    <td>@order.Buyer?.FullName</td>
                    <td>@order.QuantityOrdered @order.Produce?.Unit</td>
                    <td>₹@order.TotalPrice</td>
                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                    <td>
                        @{
                            var badgeClass = order.Status switch
                            {
                                OrderStatus.Pending => "bg-warning text-dark",
                                OrderStatus.Accepted => "bg-primary",
                                OrderStatus.Completed => "bg-success",
                                OrderStatus.Rejected => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@order.Status</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
