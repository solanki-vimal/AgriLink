@model IEnumerable<AgriLink.Models.Order>
@using AgriLink.Models

@{
    ViewData["Title"] = "Manage Orders";
}

<h1 class="h2 mb-3">@ViewData["Title"]</h1>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-4 text-center my-4">
        <p class="text-muted mb-0">No orders have been placed on your listings yet.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order #</th>
                        <th>Produce</th>
                        <th>Buyer</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                        <th>Order Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        var produceName = !string.IsNullOrWhiteSpace(order.ProduceName) ? order.ProduceName : (order.Produce?.Name ?? "Produce Item");
                        var unit = !string.IsNullOrWhiteSpace(order.Unit) ? order.Unit : (order.Produce?.Unit ?? "units");
                        var buyerName = order.Buyer?.FullName ?? "Buyer";
                        var unitPrice = order.UnitPrice > 0 ? order.UnitPrice : (order.QuantityOrdered > 0 ? Math.Round(order.TotalPrice / order.QuantityOrdered, 2) : 0);

                        <tr>
                            <td class="fw-bold">#@order.OrderId</td>
                            <td>@produceName</td>
                            <td>
                                <div>@buyerName</div>
                                @if (!string.IsNullOrWhiteSpace(order.Buyer?.PhoneNumber))
                                {
                                    <small class="text-muted"><i class="bi bi-telephone"></i> @order.Buyer.PhoneNumber</small>
                                }
                            </td>
                            <td>@order.QuantityOrdered @unit</td>
                            <td>₹@unitPrice.ToString("N2")</td>
                            <td class="fw-bold text-success">₹@order.TotalPrice.ToString("N2")</td>
                            <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                @{
                                    var badgeClass = order.Status switch
                                    {
                                        OrderStatus.Pending => "bg-warning text-dark",
                                        OrderStatus.Negotiating => "bg-info text-dark",
                                        OrderStatus.Accepted => "bg-primary",
                                        OrderStatus.Completed => "bg-success",
                                        OrderStatus.Rejected => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@order.Status</span>
                            </td>
                            <td class="text-end text-nowrap">
                                @if (order.Status == OrderStatus.Pending)
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <input type="hidden" name="newStatus" value="@OrderStatus.Accepted" />
                                        <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                    </form>
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <input type="hidden" name="newStatus" value="@OrderStatus.Rejected" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                    </form>
                                }
                                else if (order.Status == OrderStatus.Accepted)
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <input type="hidden" name="newStatus" value="@OrderStatus.Completed" />
                                        <button type="submit" class="btn btn-sm btn-success">Mark Completed</button>
                                    </form>
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <input type="hidden" name="newStatus" value="@OrderStatus.Rejected" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                    <a asp-action="Receipt" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-secondary ms-1" title="View Sales Receipt">
                                        <i class="bi bi-receipt"></i> Receipt
                                    </a>
                                }
                                else if (order.Status == OrderStatus.Completed)
                                {
                                    <a asp-action="Receipt" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-secondary" title="View Sales Receipt">
                                        <i class="bi bi-receipt"></i> Receipt
                                    </a>
                                }
                                else if (order.Status == OrderStatus.Negotiating)
                                {
                                    <a asp-action="Negotiate" asp-route-id="@order.OrderId" class="btn btn-sm btn-primary fw-semibold" title="Review Price Negotiation">
                                        <i class="bi bi-chat-quote me-1"></i> Review Offer
                                    </a>
                                }
                                else if (order.Status == OrderStatus.Rejected)
                                {
                                    <span class="text-danger small fw-semibold">Rejected</span>
                                }
                                else
                                {
                                    <span class="text-muted small">No actions</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
