@model AgriLink.Models.Order
@using AgriLink.Models

@{
    bool isOfficialReceipt = Model.Status == OrderStatus.Accepted || Model.Status == OrderStatus.Completed;
    string docTitle = isOfficialReceipt ? "Receipt" : "Order Summary";
    string receiptNumber = $"AGL-{Model.OrderDate:yyyy}-{Model.OrderId:D6}";
    ViewData["Title"] = $"{docTitle} - {receiptNumber}";

    var produceName = !string.IsNullOrWhiteSpace(Model.ProduceName) ? Model.ProduceName : (Model.Produce?.Name ?? "Produce Item");
    var unit = !string.IsNullOrWhiteSpace(Model.Unit) ? Model.Unit : (Model.Produce?.Unit ?? "units");
    var farmerName = !string.IsNullOrWhiteSpace(Model.FarmerName) ? Model.FarmerName : (Model.Produce?.Farmer?.FullName ?? "Farmer");
    var buyerName = Model.Buyer?.FullName ?? "Buyer";
    var unitPrice = Model.UnitPrice > 0 ? Model.UnitPrice : (Model.QuantityOrdered > 0 ? Math.Round(Model.TotalPrice / Model.QuantityOrdered, 2) : 0);
}

<!-- Print-Friendly Styling -->
<style>
    @@media print {
        header, footer, .navbar, .no-print, .btn, .alert {
            display: none !important;
        }
        body {
            background-color: #ffffff !important;
            font-size: 11pt !important;
            color: #000000 !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .container {
            max-width: 100% !important;
            width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .receipt-card {
            box-shadow: none !important;
            border: 1px solid #dee2e6 !important;
            border-radius: 0 !important;
            page-break-inside: avoid;
        }
        .receipt-watermark {
            opacity: 0.15 !important;
        }
    }

    .receipt-card {
        border: 1px solid #e9ecef;
        background: #ffffff;
        position: relative;
    }
</style>

<div class="container py-4" style="max-width: 860px;">
    <!-- Top Action Toolbar (Hidden in Print) -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print flex-wrap gap-2">
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-primary btn-sm">
                <i class="bi bi-printer me-1"></i> Print / Save as PDF
            </button>
        </div>
    </div>

    @if (!isOfficialReceipt)
    {
        <!-- Notice if not yet accepted/completed -->
        <div class="alert alert-warning d-flex align-items-center mb-4 no-print shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-2"></i>
            <div>
                <strong>Order Summary (Proforma):</strong> This order is currently <strong>@Model.Status</strong>. The final official sales receipt becomes active once the farmer accepts the order.
            </div>
        </div>
    }

    <!-- The Printable Receipt Document -->
    <div class="card receipt-card rounded-4 shadow-sm p-4 p-md-5">
        <!-- Receipt Header -->
        <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4 flex-wrap gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <img src="~/favicon.svg" alt="AgriLink" width="36" height="36" />
                    <span class="fs-4 fw-bold text-success tracking-tight">AgriLink</span>
                </div>
                <p class="text-muted small mb-0">Direct Farm-to-Buyer Agricultural Marketplace</p>
                <p class="text-muted small mb-0">Connecting local producers without intermediary markups</p>
            </div>
            <div class="text-md-end">
                <span class="badge @(isOfficialReceipt ? "bg-success" : "bg-warning text-dark") px-3 py-2 text-uppercase mb-2">
                    @(isOfficialReceipt ? "Official Receipt" : "Order Summary")
                </span>
                <div class="fw-bold fs-5 text-dark">@receiptNumber</div>
                <div class="text-muted small">Order ID: #@Model.OrderId</div>
                <div class="text-muted small">Date: @Model.OrderDate.ToString("MMMM dd, yyyy")</div>
            </div>
        </div>

        <!-- Parties Details (Two Columns) -->
        <div class="row g-4 mb-4 pb-3 border-bottom">
            <!-- Farmer / Seller -->
            <div class="col-sm-6">
                <h6 class="text-uppercase text-muted fw-bold small mb-2">
                    <i class="bi bi-person-badge text-success me-1"></i> Farmer (Seller)
                </h6>
                <div class="fw-bold fs-6 text-dark mb-1">@farmerName</div>
                @if (!string.IsNullOrWhiteSpace(Model.Produce?.Farmer?.Address))
                {
                    <div class="text-muted small mb-1">
                        <i class="bi bi-geo-alt me-1"></i> @Model.Produce.Farmer.Address
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Produce?.Farmer?.PhoneNumber))
                {
                    <div class="text-muted small mb-1">
                        <i class="bi bi-telephone me-1"></i> @Model.Produce.Farmer.PhoneNumber
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Produce?.Farmer?.Email))
                {
                    <div class="text-muted small">
                        <i class="bi bi-envelope me-1"></i> @Model.Produce.Farmer.Email
                    </div>
                }
            </div>

            <!-- Buyer -->
            <div class="col-sm-6 text-sm-end">
                <h6 class="text-uppercase text-muted fw-bold small mb-2">
                    <i class="bi bi-person text-primary me-1"></i> Buyer (Customer)
                </h6>
                <div class="fw-bold fs-6 text-dark mb-1">@buyerName</div>
                @if (!string.IsNullOrWhiteSpace(Model.Buyer?.Address))
                {
                    <div class="text-muted small mb-1">
                        <i class="bi bi-geo-alt me-1"></i> @Model.Buyer.Address
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Buyer?.PhoneNumber))
                {
                    <div class="text-muted small mb-1">
                        <i class="bi bi-telephone me-1"></i> @Model.Buyer.PhoneNumber
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Buyer?.Email))
                {
                    <div class="text-muted small">
                        <i class="bi bi-envelope me-1"></i> @Model.Buyer.Email
                    </div>
                }
            </div>
        </div>

        <!-- Itemized Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th>Item Description</th>
                        <th class="text-center" style="width: 18%;">Quantity</th>
                        <th class="text-end" style="width: 20%;">Unit Price</th>
                        <th class="text-end" style="width: 22%;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">1</td>
                        <td>
                            <div class="fw-bold">@produceName</div>
                            @if (Model.Produce?.Category != null)
                            {
                                <small class="text-muted">Category: @Model.Produce.Category.Name</small>
                            }
                        </td>
                        <td class="text-center">@Model.QuantityOrdered @unit</td>
                        <td class="text-end">₹@unitPrice.ToString("N2")</td>
                        <td class="text-end fw-semibold">₹@Model.TotalPrice.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Total Breakdown -->
        <div class="row justify-content-end mb-4">
            <div class="col-sm-6 col-md-5">
                <table class="table table-borderless table-sm mb-0">
                    <tr>
                        <td class="text-muted">Subtotal:</td>
                        <td class="text-end fw-semibold">₹@Model.TotalPrice.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Platform Fee:</td>
                        <td class="text-end text-success fw-semibold">₹0.00 <small class="text-muted">(Free)</small></td>
                    </tr>
                    <tr class="border-top">
                        <td class="fs-5 fw-bold text-dark pt-2">Total Amount:</td>
                        <td class="fs-5 fw-bold text-success text-end pt-2">₹@Model.TotalPrice.ToString("N2")</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Status & Direct Settlement Notice -->
        <div class="border rounded-3 p-3 bg-light mb-4">
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-info-circle-fill text-primary"></i>
                <h6 class="fw-bold mb-0">Direct Payment Notice</h6>
            </div>
            <p class="text-muted small mb-0">
                Payment is settled directly between the buyer and farmer upon produce handover or delivery (via Cash, UPI, or Direct Bank Transfer). AgriLink connects farmers directly with buyers and does not process or escrow payments.
            </p>
        </div>

        <!-- Document Footer -->
        <div class="border-top pt-3 text-center text-muted small d-flex justify-content-between flex-wrap gap-2">
            <span>Generated electronically on @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")</span>
            <span>Document ID: @receiptNumber</span>
        </div>
    </div>
</div>
