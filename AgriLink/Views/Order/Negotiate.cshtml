@model AgriLink.Models.Order
@using AgriLink.Models

@{
    ViewData["Title"] = $"Price Negotiation - Order #{Model.OrderId}";
    var currentUserId = ViewBag.CurrentUserId as string ?? "";
    bool isFarmer = ViewBag.IsFarmer == true;
    bool isBuyer = ViewBag.IsBuyer == true;
    var marketBenchmark = ViewBag.MarketBenchmark as AgriLink.Models.MarketPrice;

    var sortedOffers = Model.PriceOffers.OrderBy(po => po.CreatedAt).ToList();
    var activeOffer = sortedOffers.LastOrDefault(po => po.Status == OfferStatus.Pending);
    bool isMyTurn = activeOffer != null && activeOffer.ProposerId != currentUserId;
    bool isWaitingForOther = activeOffer != null && activeOffer.ProposerId == currentUserId;
    decimal listingPrice = Model.Produce?.Price ?? Model.UnitPrice;
    decimal minAllowedFloor = Math.Round(listingPrice * 0.5m, 2);
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            @if (isFarmer)
            {
                <li class="breadcrumb-item"><a asp-action="Manage">Manage Orders</a></li>
            }
            else
            {
                <li class="breadcrumb-item"><a asp-action="Index">My Orders</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">Negotiation #@Model.OrderId</li>
        </ol>
    </nav>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-info-circle me-1"></i>@TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-chat-quote-fill text-primary me-2"></i>Price Negotiation
                <span class="text-muted fw-normal fs-5">#@Model.OrderId</span>
            </h2>
            <div class="text-muted small">
                Placed on @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
            </div>
        </div>
        <div>
            @if (Model.Status == OrderStatus.Negotiating)
            {
                <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-arrow-repeat me-1"></i>Negotiating (Round @(activeOffer?.RoundNumber ?? 1) of 3)
                </span>
            }
            else if (Model.Status == OrderStatus.Accepted)
            {
                <span class="badge bg-success fs-6 px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-check-circle me-1"></i>Agreed &amp; Accepted
                </span>
            }
            else if (Model.Status == OrderStatus.Rejected)
            {
                <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-x-circle me-1"></i>Negotiation Declined
                </span>
            }
            else
            {
                <span class="badge bg-secondary fs-6 px-3 py-2 rounded-pill shadow-sm">@Model.Status</span>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Produce & Benchmark Details -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Produce?.ImageUrl))
                    {
                        <img src="@Model.Produce.ImageUrl" alt="@Model.ProduceName" class="img-fluid rounded mb-3 w-100 object-fit-cover" style="max-height: 180px;" />
                    }

                    <h5 class="fw-bold mb-1">@Model.ProduceName</h5>
                    <p class="text-muted small mb-3">
                        <i class="bi bi-tag-fill me-1"></i>@(Model.Produce?.Category?.Name ?? "Produce")
                    </p>

                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between px-0 py-2">
                            <span class="text-muted">Quantity Ordered:</span>
                            <span class="fw-bold">@Model.QuantityOrdered @Model.Unit</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0 py-2">
                            <span class="text-muted">Listing Base Price:</span>
                            <span class="fw-bold">₹@listingPrice.ToString("N2") / @Model.Unit</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0 py-2">
                            <span class="text-muted">Floor Price (50% min):</span>
                            <span class="text-muted">₹@minAllowedFloor.ToString("N2") / @Model.Unit</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0 py-2">
                            <span class="text-muted">Current Proposed Rate:</span>
                            <span class="fw-bold text-success fs-6">₹@Model.UnitPrice.ToString("N2") / @Model.Unit</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0 py-2 bg-light-subtle rounded px-2 mt-2">
                            <span class="fw-semibold">Proposed Order Total:</span>
                            <span class="fw-bold text-primary fs-5">₹@Model.TotalPrice.ToString("N2")</span>
                        </li>
                    </ul>

                    <hr class="my-3" />

                    <div class="small">
                        <div class="mb-1 text-muted"><strong>Buyer:</strong> @(Model.Buyer?.FullName ?? "Buyer") (@Model.Buyer?.Email)</div>
                        <div class="text-muted"><strong>Farmer:</strong> @Model.FarmerName</div>
                    </div>
                </div>
            </div>

            <!-- Agmarknet Market Benchmark Card -->
            @if (marketBenchmark != null)
            {
                <div class="card border-0 shadow-sm border-start border-primary border-4 mb-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-graph-up-arrow text-primary fs-4 me-2"></i>
                            <div>
                                <h6 class="fw-bold mb-0">Agmarknet Price Anchor</h6>
                                <span class="text-muted" style="font-size: 0.75rem;">Official Market Benchmark</span>
                            </div>
                        </div>
                        <div class="display-6 fw-bold text-primary mb-1">
                            ₹@marketBenchmark.PricePerUnit.ToString("N2")
                            <span class="fs-6 fw-normal text-muted">/ @marketBenchmark.Unit</span>
                        </div>
                        <p class="text-muted small mb-0">
                            Recorded on @marketBenchmark.Date.ToString("dd MMM yyyy") (@(marketBenchmark.Source == "Agmarknet" ? "Agmarknet Mandi Rate" : "Official Benchmark Rate")).
                            Use this rate as a fair market anchor during price discussions.
                        </p>
                    </div>
                </div>
            }
        </div>

        <!-- Right Column: Negotiation Thread & Actions -->
        <div class="col-lg-8">
            <!-- Active Decision Card (If it's user's turn) -->
            @if (Model.Status == OrderStatus.Negotiating && isMyTurn && activeOffer != null)
            {
                <div class="card border-primary shadow-sm mb-4 bg-primary-subtle border-2">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <span class="badge bg-primary text-uppercase px-2 py-1 mb-1">Action Required</span>
                                <h4 class="fw-bold mb-1">You have received a Round @activeOffer.RoundNumber offer!</h4>
                                <p class="text-muted mb-0 small">
                                    Offered by <strong>@(activeOffer.Proposer?.FullName ?? "Counterpart")</strong>:
                                    <span class="fs-5 fw-bold text-success ms-1">₹@activeOffer.OfferedUnitPrice.ToString("N2") / @Model.Unit</span>
                                    (Total: ₹@(Math.Round(Model.QuantityOrdered * activeOffer.OfferedUnitPrice, 2).ToString("N2")))
                                </p>
                            </div>
                            <div class="text-end small text-muted">
                                <div><i class="bi bi-clock-history me-1"></i>Expires:</div>
                                <div class="fw-bold text-danger">@activeOffer.ExpiresAt.ToString("dd MMM, hh:mm tt")</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(activeOffer.Message))
                        {
                            <div class="alert alert-light border small py-2 px-3 mb-3">
                                <em>"@activeOffer.Message"</em>
                            </div>
                        }

                        <div class="d-flex flex-wrap gap-2 pt-2">
                            <!-- Accept Form -->
                            <form asp-action="AcceptOffer" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@Model.OrderId" />
                                <input type="hidden" name="offerId" value="@activeOffer.PriceOfferId" />
                                <button type="submit" class="btn btn-success fw-bold px-4" onclick="return confirm('Accept this price offer of ₹@activeOffer.OfferedUnitPrice.ToString("N2") and confirm order?');">
                                    <i class="bi bi-check-lg me-1"></i>Accept Offer
                                </button>
                            </form>

                            <!-- Counter Offer Button (trigger modal/form) -->
                            @if (activeOffer.RoundNumber < 3)
                            {
                                <button type="button" class="btn btn-outline-primary fw-bold px-3" data-bs-toggle="collapse" data-bs-target="#counterOfferCollapse" aria-expanded="false" aria-controls="counterOfferCollapse">
                                    <i class="bi bi-arrow-left-right me-1"></i>Make Counter-Offer (Round @(activeOffer.RoundNumber + 1) of 3)
                                </button>
                            }
                            else
                            {
                                <span class="badge bg-secondary align-self-center py-2 px-3">Max 3 negotiation rounds reached</span>
                            }

                            <!-- Decline/Reject Form -->
                            <form asp-action="RejectOffer" method="post" class="d-inline ms-auto">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@Model.OrderId" />
                                <input type="hidden" name="offerId" value="@activeOffer.PriceOfferId" />
                                <button type="submit" class="btn btn-outline-danger px-3" onclick="return confirm('Decline this negotiation? The order will be marked as Rejected.');">
                                    <i class="bi bi-x-lg me-1"></i>Decline
                                </button>
                            </form>
                        </div>

                        <!-- Collapsible Counter-Offer Form -->
                        @if (activeOffer.RoundNumber < 3)
                        {
                            <div class="collapse mt-3" id="counterOfferCollapse">
                                <div class="card card-body bg-white border">
                                    <h6 class="fw-bold mb-3">Submit Counter-Offer (Round @(activeOffer.RoundNumber + 1) of 3)</h6>
                                    <form asp-action="CounterOffer" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                                        <input type="hidden" name="previousOfferId" value="@activeOffer.PriceOfferId" />

                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label small fw-semibold">Your Counter Unit Price (₹ / @Model.Unit)</label>
                                                <div class="input-group">
                                                    <span class="input-group-text">₹</span>
                                                    <input type="number" name="counterPrice" class="form-control" step="0.5" min="@minAllowedFloor" required placeholder="e.g. @Model.UnitPrice" />
                                                </div>
                                                <div class="form-text small">Minimum allowed: ₹@minAllowedFloor.ToString("N2") (50% floor).</div>
                                            </div>
                                            <div class="col-md-12">
                                                <label class="form-label small fw-semibold">Note / Justification (Optional)</label>
                                                <input type="text" name="message" class="form-control" maxlength="500" placeholder="e.g. Best price considering packaging and delivery costs..." />
                                            </div>
                                            <div class="col-12 text-end">
                                                <button type="submit" class="btn btn-primary fw-bold px-4">
                                                    <i class="bi bi-send me-1"></i>Send Counter-Offer
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (Model.Status == OrderStatus.Negotiating && isWaitingForOther && activeOffer != null)
            {
                <div class="card border-0 shadow-sm mb-4 bg-warning-subtle">
                    <div class="card-body p-4 d-flex align-items-center gap-3">
                        <div class="spinner-border text-warning" role="status">
                            <span class="visually-hidden">Waiting...</span>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1">Awaiting Response to Round @activeOffer.RoundNumber Offer</h5>
                            <p class="mb-0 text-muted small">
                                Your offer of <strong>₹@activeOffer.OfferedUnitPrice.ToString("N2") / @Model.Unit</strong> has been submitted.
                                Waiting for <strong>@(isFarmer ? "the buyer" : "the farmer")</strong> to accept, counter, or decline.
                                (Offer expires on @activeOffer.ExpiresAt.ToString("dd MMM, hh:mm tt")).
                            </p>
                        </div>
                    </div>
                </div>
            }
            else if (Model.Status == OrderStatus.Accepted)
            {
                <div class="card border-0 shadow-sm mb-4 bg-success-subtle">
                    <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div>
                            <h5 class="fw-bold text-success mb-1"><i class="bi bi-check-circle-fill me-2"></i>Negotiation Successfully Completed</h5>
                            <p class="mb-0 text-muted small">Both parties agreed on <strong>₹@Model.UnitPrice.ToString("N2") / @Model.Unit</strong>. Stock has been reserved.</p>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Confirmation" asp-route-id="@Model.OrderId" class="btn btn-success fw-semibold">
                                <i class="bi bi-bag-check me-1"></i>View Order Details
                            </a>
                            <a asp-action="Receipt" asp-route-id="@Model.OrderId" class="btn btn-outline-success fw-semibold">
                                <i class="bi bi-receipt me-1"></i>View Receipt
                            </a>
                        </div>
                    </div>
                </div>
            }
            else if (Model.Status == OrderStatus.Rejected)
            {
                <div class="card border-0 shadow-sm mb-4 bg-danger-subtle">
                    <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div>
                            <h5 class="fw-bold text-danger mb-1"><i class="bi bi-x-circle-fill me-2"></i>Negotiation Ended / Declined</h5>
                            <p class="mb-0 text-muted small">This negotiation was declined or expired. No produce stock was deducted.</p>
                        </div>
                        <div>
                            <a asp-action="Confirmation" asp-route-id="@Model.OrderId" class="btn btn-outline-danger fw-semibold">
                                <i class="bi bi-info-circle me-1"></i>View Status Details
                            </a>
                        </div>
                    </div>
                </div>
            }

            <!-- Negotiation History Timeline -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Negotiation History</h5>
                    <span class="badge bg-light text-dark border">@sortedOffers.Count @(sortedOffers.Count == 1 ? "Offer" : "Offers")</span>
                </div>
                <div class="card-body p-4">
                    @if (!sortedOffers.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-chat-dots fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <p class="mb-0">No price offers recorded yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="timeline position-relative">
                            @foreach (var offer in sortedOffers)
                            {
                                bool isBuyerOffer = offer.ProposerId == Model.BuyerId;
                                bool isMyOffer = offer.ProposerId == currentUserId;

                                <div class="card mb-3 border @(offer.Status == OfferStatus.Accepted ? "border-success bg-success-subtle" : offer.Status == OfferStatus.Pending ? "border-primary" : "border-light-subtle bg-light")">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge @(offer.RoundNumber == 1 ? "bg-secondary" : "bg-primary")">Round @offer.RoundNumber</span>
                                                <span class="fw-bold text-dark">
                                                    @(isMyOffer ? "You" : (offer.Proposer?.FullName ?? (isBuyerOffer ? "Buyer" : "Farmer")))
                                                    <span class="text-muted fw-normal small">(@(isBuyerOffer ? "Buyer" : "Farmer"))</span>
                                                </span>
                                            </div>
                                            <div>
                                                @if (offer.Status == OfferStatus.Pending)
                                                {
                                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pending</span>
                                                }
                                                else if (offer.Status == OfferStatus.Accepted)
                                                {
                                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Accepted</span>
                                                }
                                                else if (offer.Status == OfferStatus.Countered)
                                                {
                                                    <span class="badge bg-secondary"><i class="bi bi-arrow-repeat me-1"></i>Countered</span>
                                                }
                                                else if (offer.Status == OfferStatus.Rejected)
                                                {
                                                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Declined</span>
                                                }
                                                else if (offer.Status == OfferStatus.Expired)
                                                {
                                                    <span class="badge bg-dark"><i class="bi bi-hourglass-bottom me-1"></i>Expired</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                                            <div class="fs-4 fw-bold text-dark">
                                                ₹@offer.OfferedUnitPrice.ToString("N2")
                                                <span class="fs-6 text-muted fw-normal">/ @Model.Unit</span>
                                                <span class="fs-6 text-muted fw-normal ms-2">(Total: ₹@(Math.Round(Model.QuantityOrdered * offer.OfferedUnitPrice, 2).ToString("N2")))</span>
                                            </div>
                                            <div class="text-muted small">
                                                @offer.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(offer.Message))
                                        {
                                            <div class="p-2 bg-white rounded border small text-secondary">
                                                <i class="bi bi-chat-left-text me-1 text-muted"></i>"@offer.Message"
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <div class="mt-4 pt-2 border-top d-flex justify-content-between align-items-center">
                        @if (isFarmer)
                        {
                            <a asp-action="Manage" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to Manage Orders
                            </a>
                        }
                        else
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to My Orders
                            </a>
                        }

                        <a asp-controller="Browse" asp-action="Details" asp-route-id="@Model.ProduceId" class="btn btn-link text-decoration-none">
                            <i class="bi bi-box-arrow-up-right me-1"></i>View Produce Listing
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
