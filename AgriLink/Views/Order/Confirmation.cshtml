@model AgriLink.Models.Order
@using AgriLink.Models

@{
    ViewData["Title"] = $"Order #{Model.OrderId} Details";
    var produceName = !string.IsNullOrWhiteSpace(Model.ProduceName) ? Model.ProduceName : (Model.Produce?.Name ?? "Produce Item");
    var unit = !string.IsNullOrWhiteSpace(Model.Unit) ? Model.Unit : (Model.Produce?.Unit ?? "units");
    var farmerName = !string.IsNullOrWhiteSpace(Model.FarmerName) ? Model.FarmerName : (Model.Produce?.Farmer?.FullName ?? "Farmer");
    var unitPrice = Model.UnitPrice > 0 ? Model.UnitPrice : (Model.QuantityOrdered > 0 ? Math.Round(Model.TotalPrice / Model.QuantityOrdered, 2) : 0);
}

<div class="container py-4" style="max-width: 820px;">
    <!-- Top Navigation Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Order" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to My Orders
            </a>
            <a asp-controller="Browse" asp-action="Index" class="btn btn-outline-success btn-sm">
                <i class="bi bi-cart-plus me-1"></i> Continue Shopping
            </a>
        </div>
        @if (Model.Status == OrderStatus.Negotiating)
        {
            <a asp-controller="Order" asp-action="Negotiate" asp-route-id="@Model.OrderId" class="btn btn-warning btn-sm fw-semibold">
                <i class="bi bi-chat-quote me-1"></i> Review Negotiation
            </a>
        }
        else if (Model.Status == OrderStatus.Accepted || Model.Status == OrderStatus.Completed)
        {
            <a asp-controller="Order" asp-action="Receipt" asp-route-id="@Model.OrderId" class="btn btn-primary btn-sm">
                <i class="bi bi-receipt me-1"></i> View & Print Receipt
            </a>
        }
        else if (Model.Status != OrderStatus.Rejected)
        {
            <a asp-controller="Order" asp-action="Receipt" asp-route-id="@Model.OrderId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-file-text me-1"></i> View Order Summary
            </a>
        }
    </div>

    <!-- Status-Aware Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        @if (Model.Status == OrderStatus.Rejected)
        {
            <div class="card-body bg-danger bg-opacity-10 p-4 p-md-5 text-center">
                <div class="d-inline-flex align-items-center justify-content-center bg-danger text-white rounded-circle mb-3" style="width: 72px; height: 72px;">
                    <i class="bi bi-x-lg fs-1"></i>
                </div>
                <h1 class="h3 fw-bold text-danger mb-2">Order Declined by Farmer</h1>
                <p class="text-muted mb-0">
                    Unfortunately, <strong>@farmerName</strong> was unable to fulfill this order (e.g. out of harvest inventory or unavailable). No payment is due.
                </p>
            </div>
        }
        else if (Model.Status == OrderStatus.Accepted)
        {
            <div class="card-body bg-primary bg-opacity-10 p-4 p-md-5 text-center">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3" style="width: 72px; height: 72px;">
                    <i class="bi bi-check2-circle fs-1"></i>
                </div>
                <h1 class="h3 fw-bold text-primary mb-2">Order Accepted by Farmer!</h1>
                <p class="text-muted mb-0">
                    Great news! <strong>@farmerName</strong> has confirmed your order. Your produce is reserved for you.
                </p>
            </div>
        }
        else if (Model.Status == OrderStatus.Completed)
        {
            <div class="card-body bg-success bg-opacity-10 p-4 p-md-5 text-center">
                <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-3" style="width: 72px; height: 72px;">
                    <i class="bi bi-patch-check-fill fs-1"></i>
                </div>
                <h1 class="h3 fw-bold text-success mb-2">Order Fulfilled & Completed</h1>
                <p class="text-muted mb-0">
                    This order has been completed with <strong>@farmerName</strong>. Thank you for supporting local farmers!
                </p>
            </div>
        }
        else if (Model.Status == OrderStatus.Negotiating)
        {
            <div class="card-body bg-warning bg-opacity-10 p-4 p-md-5 text-center">
                <div class="d-inline-flex align-items-center justify-content-center bg-warning text-dark rounded-circle mb-3" style="width: 72px; height: 72px;">
                    <i class="bi bi-chat-quote-fill fs-1"></i>
                </div>
                <h1 class="h3 fw-bold text-dark mb-2">Price Negotiation in Progress</h1>
                <p class="text-muted mb-3">
                    A price offer has been placed for this order. Produce stock remains unreserved until an agreement is reached.
                </p>
                <a asp-controller="Order" asp-action="Negotiate" asp-route-id="@Model.OrderId" class="btn btn-warning fw-bold px-4">
                    <i class="bi bi-chat-left-text me-1"></i> Open Negotiation Thread
                </a>
            </div>
        }
        else
        {
            <div class="card-body bg-success bg-opacity-10 p-4 p-md-5 text-center">
                <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-3" style="width: 72px; height: 72px;">
                    <i class="bi bi-hourglass-split fs-1"></i>
                </div>
                <h1 class="h3 fw-bold text-success mb-2">Order Placed Successfully!</h1>
                <p class="text-muted mb-0">
                    Thank you for your order. A request has been sent to <strong>@farmerName</strong> to review and confirm.
                </p>
            </div>
        }
    </div>

    <!-- Order Details Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="text-muted small text-uppercase fw-semibold">Order Reference</span>
                <h5 class="mb-0 fw-bold">#@Model.OrderId</h5>
            </div>
            <div class="text-md-end">
                <span class="text-muted small">Placed on:</span>
                <div class="fw-semibold text-dark">@Model.OrderDate.ToString("MMM dd, yyyy · hh:mm tt")</div>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-4 align-items-center">
                @if (!string.IsNullOrEmpty(Model.Produce?.ImageUrl))
                {
                    <div class="col-12 col-sm-3 text-center">
                        <img src="@Model.Produce.ImageUrl" alt="@produceName" class="img-fluid rounded-3 shadow-sm" style="max-height: 120px; object-fit: cover; width: 100%;" />
                    </div>
                }
                <div class="@(!string.IsNullOrEmpty(Model.Produce?.ImageUrl) ? "col-12 col-sm-9" : "col-12")">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                        <div>
                            <h4 class="fw-bold mb-1">@produceName</h4>
                            <p class="text-muted small mb-0">
                                Sold by: <span class="fw-semibold text-dark">@farmerName</span>
                                @if (!string.IsNullOrWhiteSpace(Model.Produce?.Farmer?.Address))
                                {
                                    <span> · <i class="bi bi-geo-alt text-success"></i> @Model.Produce.Farmer.Address</span>
                                }
                            </p>
                        </div>
                        <div>
                            @{
                                var badgeClass = Model.Status switch
                                {
                                    OrderStatus.Pending => "bg-warning text-dark",
                                    OrderStatus.Negotiating => "bg-info text-dark",
                                    OrderStatus.Accepted => "bg-primary",
                                    OrderStatus.Completed => "bg-success",
                                    OrderStatus.Rejected => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass px-3 py-2 fs-6">
                                @if (Model.Status == OrderStatus.Rejected)
                                {
                                    <i class="bi bi-x-circle me-1"></i>
                                }
                                else if (Model.Status == OrderStatus.Accepted)
                                {
                                    <i class="bi bi-check-circle me-1"></i>
                                }
                                else if (Model.Status == OrderStatus.Completed)
                                {
                                    <i class="bi bi-check-all me-1"></i>
                                }
                                else
                                {
                                    <i class="bi bi-hourglass-split me-1"></i>
                                }
                                @Model.Status
                            </span>
                        </div>
                    </div>

                    <hr class="my-3" />

                    <!-- Price breakdown -->
                    <div class="row g-2 text-sm">
                        <div class="col-6 col-md-4">
                            <span class="text-muted small d-block">Quantity Ordered</span>
                            <span class="fw-semibold">@Model.QuantityOrdered @unit</span>
                        </div>
                        <div class="col-6 col-md-4">
                            <span class="text-muted small d-block">Unit Price</span>
                            <span class="fw-semibold">₹@unitPrice.ToString("N2") / @unit</span>
                        </div>
                        <div class="col-12 col-md-4 text-md-end">
                            <span class="text-muted small d-block">Total Amount</span>
                            <span class="fs-5 fw-bold @(Model.Status == OrderStatus.Rejected ? "text-decoration-line-through text-muted" : "text-success")">
                                ₹@Model.TotalPrice.ToString("N2")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contextual Guidance Section -->
    @if (Model.Status == OrderStatus.Rejected)
    {
        <!-- Rejection Guidance -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-2 d-flex align-items-center gap-2 text-dark">
                    <i class="bi bi-arrow-repeat text-primary"></i> Looking for Fresh Alternatives?
                </h5>
                <p class="text-muted small mb-3">
                    Because this order was declined by the seller, no produce was reserved and no payment is required. You can browse other fresh harvest listings from local farmers on the marketplace.
                </p>
                <a asp-controller="Browse" asp-action="Index" class="btn btn-outline-success">
                    <i class="bi bi-basket me-1"></i> Explore More Produce Listings
                </a>
            </div>
        </div>
    }
    else if (Model.Status == OrderStatus.Accepted)
    {
        <!-- Accepted Guidance -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2 text-primary">
                    <i class="bi bi-check-circle"></i> Next Steps for Delivery & Payment
                </h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <h6 class="fw-bold mb-1">1. Contact Farmer</h6>
                            <p class="text-muted small mb-0">
                                Call or message the farmer to agree on handover timing and pickup/delivery location.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <h6 class="fw-bold mb-1">2. Inspect Produce</h6>
                            <p class="text-muted small mb-0">
                                Verify the harvest freshness and quantity upon arrival.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <h6 class="fw-bold mb-1">3. Direct Settlement</h6>
                            <p class="text-muted small mb-0">
                                Pay the farmer directly using Cash, UPI, or your agreed method.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.Status == OrderStatus.Completed)
    {
        <!-- Completed Guidance -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4 text-center">
                <i class="bi bi-shield-check text-success fs-1 mb-2"></i>
                <h5 class="fw-bold mb-1">Transaction Completed</h5>
                <p class="text-muted small mb-0">
                    This order was finalized and settled directly with <strong>@farmerName</strong>. Thank you for supporting local agriculture!
                </p>
            </div>
        </div>
    }
    else if (Model.Status == OrderStatus.Negotiating)
    {
        <!-- Negotiating Guidance -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2 text-warning-emphasis">
                    <i class="bi bi-chat-quote"></i> How Negotiation Works
                </h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <h6 class="fw-bold mb-1">1. Propose &amp; Counter</h6>
                            <p class="text-muted small mb-0">
                                Buyer and farmer can make up to 3 rounds of counter-offers. All offers must meet the 50% minimum floor.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <h6 class="fw-bold mb-1">2. 48-Hour Expiry</h6>
                            <p class="text-muted small mb-0">
                                Each offer is valid for 48 hours. If neither party accepts within 48 hours, the order automatically closes.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <h6 class="fw-bold mb-1">3. Stock Lock on Agreement</h6>
                            <p class="text-muted small mb-0">
                                Stock remains open to other buyers until both sides accept the agreed price. Once accepted, inventory is reserved.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Pending Guidance -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle text-primary"></i> What Happens Next?
                </h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-success rounded-circle" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center;">1</span>
                                <h6 class="fw-bold mb-0">Farmer Reviews</h6>
                            </div>
                            <p class="text-muted small mb-0">
                                The farmer will check their available harvest inventory and accept the order.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-success rounded-circle" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center;">2</span>
                                <h6 class="fw-bold mb-0">Stock Reserved</h6>
                            </div>
                            <p class="text-muted small mb-0">
                                Once accepted, the ordered produce is held specifically for you.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-success rounded-circle" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center;">3</span>
                                <h6 class="fw-bold mb-0">Direct Settlement</h6>
                            </div>
                            <p class="text-muted small mb-0">
                                Payment is settled directly between you and the farmer upon handover or pickup.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
