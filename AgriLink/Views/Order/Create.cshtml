@model AgriLink.ViewModels.OrderCreateViewModel

@{
    ViewData["Title"] = "Place Order";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body d-flex gap-3">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.ProduceName" style="width:80px;height:80px;object-fit:cover;" class="rounded" />
                }
                <div>
                    <h5 class="mb-1">@Model.ProduceName</h5>
                    <div class="text-muted small">Sold by @Model.FarmerName</div>
                    <div class="fw-bold text-success">₹@Model.Price / @Model.Unit</div>
                    <div class="small">@Model.AvailableQuantity @Model.Unit available</div>
                </div>
            </div>
        </div>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ProduceId" />
            <input type="hidden" asp-for="ProduceName" />
            <input type="hidden" asp-for="Unit" />
            <input type="hidden" asp-for="Price" />
            <input type="hidden" asp-for="AvailableQuantity" />
            <input type="hidden" asp-for="FarmerName" />
            <input type="hidden" asp-for="ImageUrl" />

            <div class="mb-3">
                <label asp-for="QuantityOrdered" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="QuantityOrdered" class="form-control" step="0.1" />
                    <span class="input-group-text">@Model.Unit</span>
                </div>
                <span asp-validation-for="QuantityOrdered" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success fw-bold">Confirm Order</button>
            <a asp-controller="Browse" asp-action="Details" asp-route-id="@Model.ProduceId" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
