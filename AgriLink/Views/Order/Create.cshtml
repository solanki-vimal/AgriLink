@model AgriLink.ViewModels.OrderCreateViewModel

@{
    ViewData["Title"] = "Place Order";
    var minAllowedOffer = Math.Round(Model.Price * 0.5m, 2);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Browse" asp-action="Index">Marketplace</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Browse" asp-action="Details" asp-route-id="@Model.ProduceId">@Model.ProduceName</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Place Order</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-md-row gap-4 align-items-md-center">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.ProduceName" class="rounded object-fit-cover shadow-sm" style="width: 110px; height: 110px;" />
                        }
                        else
                        {
                            <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted" style="width: 110px; height: 110px;">
                                <i class="bi bi-basket3 fs-1"></i>
                            </div>
                        }

                        <div class="flex-grow-1">
                            <h3 class="fw-bold mb-1">@Model.ProduceName</h3>
                            <p class="text-muted mb-2">
                                <i class="bi bi-person-fill text-secondary me-1"></i>Sold by <span class="fw-semibold">@Model.FarmerName</span>
                            </p>
                            <div class="d-flex flex-wrap gap-3 align-items-center">
                                <div>
                                    <span class="text-muted small d-block">Listing Price</span>
                                    <span class="fs-4 fw-bold text-success">₹@Model.Price.ToString("N2")</span>
                                    <span class="text-muted small">/ @Model.Unit</span>
                                </div>
                                <div class="vr mx-2"></div>
                                <div>
                                    <span class="text-muted small d-block">Available Stock</span>
                                    <span class="fw-semibold">@Model.AvailableQuantity @Model.Unit</span>
                                </div>
                                @if (Model.MarketBenchmarkPrice.HasValue)
                                {
                                    <div class="vr mx-2"></div>
                                    <div class="bg-light border rounded px-3 py-1">
                                        <div class="text-muted small"><i class="bi bi-graph-up-arrow text-primary me-1"></i>Agmarknet Benchmark</div>
                                        <div class="fw-bold text-primary">₹@Model.MarketBenchmarkPrice.Value.ToString("N2") <span class="small fw-normal text-muted">/ @Model.Unit</span></div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold">Order Details</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="orderForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
                        <input type="hidden" asp-for="ProduceId" />
                        <input type="hidden" asp-for="ProduceName" />
                        <input type="hidden" asp-for="Unit" />
                        <input type="hidden" asp-for="Price" />
                        <input type="hidden" asp-for="AvailableQuantity" />
                        <input type="hidden" asp-for="FarmerName" />
                        <input type="hidden" asp-for="ImageUrl" />
                        <input type="hidden" asp-for="MarketBenchmarkPrice" />

                        <!-- Quantity -->
                        <div class="mb-4">
                            <label asp-for="QuantityOrdered" class="form-label fw-semibold">Quantity to Order <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg">
                                <input asp-for="QuantityOrdered" class="form-control" type="number" step="0.1" min="0.1" max="@Model.AvailableQuantity" id="quantityInput" placeholder="Enter quantity" />
                                <span class="input-group-text bg-light">@Model.Unit</span>
                            </div>
                            <span asp-validation-for="QuantityOrdered" class="text-danger small"></span>
                            <div class="form-text">Maximum available to order is @Model.AvailableQuantity @Model.Unit.</div>
                        </div>

                        <!-- Price Negotiation Section -->
                        <div class="card border border-success-subtle bg-light mb-4">
                            <div class="card-body p-3">
                                <div class="form-check form-switch mb-0">
                                    <input asp-for="WantToNegotiate" class="form-check-input" type="checkbox" role="switch" id="negotiateSwitch" />
                                    <label class="form-check-label fw-bold text-dark ms-2" for="negotiateSwitch">
                                        Propose a custom price (Price Negotiation)
                                    </label>
                                </div>
                                <p class="text-muted small mt-1 mb-0 ms-4 ps-2">
                                    Suggest a counter-price to the farmer. Up to 3 rounds of negotiation allowed.
                                </p>

                                <div id="negotiationInputs" class="mt-3 ps-4 ms-2 @(Model.WantToNegotiate ? "" : "d-none")">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="OfferedUnitPrice" class="form-label fw-semibold">Your Offered Unit Price</label>
                                            <div class="input-group">
                                                <span class="input-group-text">₹</span>
                                                <input asp-for="OfferedUnitPrice" class="form-control" type="number" step="0.5" min="@minAllowedOffer" max="@(Model.Price - 0.01m)" id="offeredPriceInput" placeholder="e.g. @(Math.Round(Model.Price * 0.85m, 2))" />
                                                <span class="input-group-text">/ @Model.Unit</span>
                                            </div>
                                            <span asp-validation-for="OfferedUnitPrice" class="text-danger small"></span>
                                            <div class="form-text small">
                                                Must be between <strong>₹@minAllowedOffer.ToString("N2")</strong> (50% floor) and <strong>₹@((Model.Price - 0.01m).ToString("N2"))</strong>.
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <label asp-for="OfferMessage" class="form-label fw-semibold">Note to Farmer (Optional)</label>
                                            <textarea asp-for="OfferMessage" class="form-control" rows="2" placeholder="e.g. Ordering in bulk, requesting discount as per current wholesale rates..."></textarea>
                                            <span asp-validation-for="OfferMessage" class="text-danger small"></span>
                                        </div>
                                    </div>

                                    <div class="alert alert-info py-2 px-3 mt-3 mb-0 small">
                                        <i class="bi bi-info-circle-fill me-1"></i>
                                        <strong>Negotiation Notice:</strong> Produce stock remains unreserved until final acceptance. Offers expire automatically after <strong>48 hours</strong>.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Estimated Total -->
                        <div class="bg-white border rounded p-3 mb-4 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted d-block small">Estimated Order Total</span>
                                <span class="text-muted small" id="rateCalcNotice">Calculated at listing price</span>
                            </div>
                            <div class="fs-3 fw-bold text-success" id="orderTotalDisplay">₹0.00</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success btn-lg px-4 fw-bold" id="submitBtn">
                                <i class="bi bi-check2-circle me-1"></i>Confirm &amp; Place Order
                            </button>
                            <a asp-controller="Browse" asp-action="Details" asp-route-id="@Model.ProduceId" class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const listPrice = @Model.Price;
            const qtyInput = document.getElementById('quantityInput');
            const negotiateSwitch = document.getElementById('negotiateSwitch');
            const negotiationInputs = document.getElementById('negotiationInputs');
            const offeredPriceInput = document.getElementById('offeredPriceInput');
            const totalDisplay = document.getElementById('orderTotalDisplay');
            const rateCalcNotice = document.getElementById('rateCalcNotice');
            const submitBtn = document.getElementById('submitBtn');

            function updateTotal() {
                const qty = parseFloat(qtyInput.value) || 0;
                let activeRate = listPrice;

                if (negotiateSwitch.checked) {
                    const offer = parseFloat(offeredPriceInput.value);
                    if (!isNaN(offer) && offer > 0) {
                        activeRate = offer;
                        rateCalcNotice.textContent = `Calculated at proposed offer rate of ₹${offer.toFixed(2)}`;
                    } else {
                        rateCalcNotice.textContent = `Enter your proposed rate above`;
                    }
                } else {
                    rateCalcNotice.textContent = `Calculated at listing price (₹${listPrice.toFixed(2)})`;
                }

                const total = Math.max(0, qty * activeRate);
                totalDisplay.textContent = `₹${total.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            }

            negotiateSwitch.addEventListener('change', function () {
                if (this.checked) {
                    negotiationInputs.classList.remove('d-none');
                    submitBtn.innerHTML = '<i class="bi bi-send me-1"></i>Send Order &amp; Price Offer';
                } else {
                    negotiationInputs.classList.add('d-none');
                    submitBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Confirm &amp; Place Order';
                }
                updateTotal();
            });

            qtyInput.addEventListener('input', updateTotal);
            offeredPriceInput.addEventListener('input', updateTotal);

            // Initial calculation
            updateTotal();
        });
    </script>
}
