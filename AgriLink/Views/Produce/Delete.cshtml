@model AgriLink.Models.Produce

@{
    ViewData["Title"] = "Delete Produce Listing";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card border-0 shadow-sm border-danger border-top border-4">
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    <div class="fs-1 text-danger">⚠️</div>
                    <h4 class="fw-bold text-danger">Delete Produce Listing</h4>
                    <p class="text-muted">Are you sure you want to delete this listing from the marketplace?</p>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" style="width:70px;height:70px;object-fit:cover;" class="rounded-3 shadow-sm" />
                        }
                        else
                        {
                            <div class="bg-white rounded-3 p-3 text-center fs-3">🌱</div>
                        }
                        <div>
                            <h5 class="fw-bold mb-0">@Model.Name</h5>
                            <span class="badge bg-success bg-opacity-10 text-success fw-semibold">@Model.Category?.Name</span>
                        </div>
                    </div>

                    <dl class="row mb-0 small">
                        <dt class="col-sm-4 text-muted fw-semibold">Quantity</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Quantity @Model.Unit</dd>

                        <dt class="col-sm-4 text-muted fw-semibold">Price</dt>
                        <dd class="col-sm-8 text-success fw-bold">₹@Model.Price / @Model.Unit</dd>

                        <dt class="col-sm-4 text-muted fw-semibold">Location</dt>
                        <dd class="col-sm-8">@Model.Location</dd>
                    </dl>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-2">
                    <input type="hidden" asp-for="ProduceId" />
                    <button type="submit" class="btn btn-danger fw-bold px-4">Delete Listing</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
