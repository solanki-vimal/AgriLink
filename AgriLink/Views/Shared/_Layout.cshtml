@inject AgriLink.Services.IOrderNotificationService OrderNotificationService
@inject Microsoft.AspNetCore.Identity.UserManager<AgriLink.Models.ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgriLink</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AgriLink.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-success d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/favicon.svg" alt="AgriLink Logo" width="28" height="28" class="d-inline-block align-text-top" />
                    <span>AgriLink</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-lg-inline-flex justify-content-between" id="navbarSupportedContent">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Browse" asp-action="Index">🛒 Marketplace</a>
                        </li>
                        @if (User.IsInRole("Farmer"))
                        {
                            var farmerId = UserManager.GetUserId(User);
                            var pendingFarmerOffers = !string.IsNullOrEmpty(farmerId) ? await OrderNotificationService.GetPendingFarmerNegotiationsCountAsync(farmerId) : 0;
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Produce" asp-action="Index">My Produce</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark d-flex align-items-center gap-1" asp-area="" asp-controller="Order" asp-action="Manage">
                                    Manage Orders
                                    @if (pendingFarmerOffers > 0)
                                    {
                                        <span class="badge rounded-pill bg-danger" title="@pendingFarmerOffers offers waiting for your review">@pendingFarmerOffers</span>
                                    }
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="FarmerProfile" asp-action="Index">My Farm Profile</a>
                            </li>
                        }
                        @if (User.IsInRole("Buyer"))
                        {
                            var buyerId = UserManager.GetUserId(User);
                            var pendingBuyerOffers = !string.IsNullOrEmpty(buyerId) ? await OrderNotificationService.GetPendingBuyerNegotiationsCountAsync(buyerId) : 0;
                            <li class="nav-item">
                                <a class="nav-link text-dark d-flex align-items-center gap-1" asp-area="" asp-controller="Order" asp-action="Index">
                                    My Orders
                                    @if (pendingBuyerOffers > 0)
                                    {
                                        <span class="badge rounded-pill bg-danger" title="@pendingBuyerOffers counter-offers waiting for your response">@pendingBuyerOffers</span>
                                    }
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Category" asp-action="Index">Manage Categories</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="MarketPrice" asp-action="Index">Market Prices</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Users">All Users</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Listings">All Listings</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Orders">All Orders</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData["StatusMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                @TempData["StatusMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AgriLink - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
