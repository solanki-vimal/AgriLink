@using Microsoft.AspNetCore.Identity
@using AgriLink.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ApplicationUser? currentUser = null;
    IList<string> userRoles = new List<string>();
    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            userRoles = await UserManager.GetRolesAsync(currentUser);
        }
    }
}

<hr class="d-lg-none my-2 text-muted" />
<ul class="navbar-nav align-items-start align-items-lg-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item me-lg-2">
        <a class="nav-link text-dark py-1 px-0 px-lg-2 d-flex align-items-center flex-wrap gap-1" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage Profile & Account Settings">
            <i class="bi bi-person-circle text-success me-1"></i>
            <span>Hello, <strong>@currentUser?.FullName</strong></span>
            @foreach (var role in userRoles)
            {
                <span class="badge bg-secondary ms-1">@role</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link text-dark py-1 px-0 px-lg-2 d-flex align-items-center text-decoration-none">
                <i class="bi bi-box-arrow-right me-1 text-danger"></i> Logout
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark py-1 px-0 px-lg-2" asp-area="Identity" asp-page="/Account/Register">
            <i class="bi bi-person-plus me-1 d-lg-none"></i> Register
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark py-1 px-0 px-lg-2" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right me-1 d-lg-none"></i> Login
        </a>
    </li>
}
</ul>
