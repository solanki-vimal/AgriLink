@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title ?? "Error";
}

<div class="row justify-content-center my-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card border-0 shadow-sm p-4 p-md-5">
            <div class="display-3 text-danger fw-bold mb-2">
                @(Model.StatusCode.HasValue ? Model.StatusCode.Value.ToString() : "⚠️")
            </div>
            
            <h2 class="fw-bold mb-3">@(Model.Title ?? "Something went wrong")</h2>
            
            <p class="text-muted mb-4 lead">
                @(Model.Message ?? "An unexpected error occurred while processing your request.")
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="alert alert-light border small text-muted mb-4">
                    <strong>Support Reference ID:</strong> <code>@Model.RequestId</code>
                </div>
            }

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-success px-4 py-2 fw-semibold">
                    🏠 Return Home
                </a>
                <a asp-controller="Browse" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-semibold">
                    🛒 Browse Marketplace
                </a>
            </div>
        </div>
    </div>
</div>
